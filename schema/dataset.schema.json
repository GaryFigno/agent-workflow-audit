{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Workflow Audit dataset 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "stages",
    "tasks",
    "executions",
    "states",
    "attestations",
    "evidence",
    "decisions",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "metadata": {
      "type": "object",
      "required": [
        "dataset_id",
        "project_id",
        "data_kind",
        "captured_at"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "data_kind": {
          "enum": [
            "synthetic",
            "observational",
            "prospective"
          ]
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attestation"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "enrolled_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "enrolled_at": {
          "type": "string",
          "minLength": 1
        },
        "initial_version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "task_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "assigned_workflow": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "requirements_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "budget_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "budget_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": [
        "execution_id",
        "status"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "execution_kind": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "engine": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "client_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "workflow_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "created_at": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "accepted_at": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "started_at": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "finished_at": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "human_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "required": [
        "state_id",
        "task_id",
        "attempt",
        "revision",
        "is_current",
        "origin"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "is_current": {
          "type": "boolean"
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "attestation": {
      "type": "object",
      "required": [
        "attestation_id",
        "state_id",
        "stage"
      ],
      "properties": {
        "attestation_id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "execution_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "observation": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "status",
            "basis"
          ],
          "properties": {
            "status": {
              "enum": [
                "match",
                "mismatch",
                "missing",
                "unreadable",
                "unknown"
              ]
            },
            "basis": {
              "enum": [
                "retained_observation",
                "live_verification",
                "synthetic"
              ]
            },
            "actual_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_id",
        "task_id",
        "decision"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "rubric_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewer_kind": {
          "enum": [
            "human",
            "agent",
            "unknown"
          ]
        },
        "independent_reviewer": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "required": [
        "transition_id",
        "task_id",
        "category"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "from_state_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "to_state_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
